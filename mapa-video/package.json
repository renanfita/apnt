{
  "name": "mapa-tutorial",
  "version": "1.0.0",
  "private": true,
  "description": "Tutorial em vídeo do Mapa Interativo de Descarte de Resíduos no Mar — Remotion",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render Tutorial out/tutorial.mp4",
    "render": "remotion render Tutorial out/tutorial.mp4 --codec=h264 --crf=18",
    "render-webm": "remotion render Tutorial out/tutorial.webm --codec=vp9",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.350",
    "remotion": "4.0.350",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.4.5"
  }
}
